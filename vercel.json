{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run vision:assets && npm run build",
  "outputDirectory": "apps/kiosk/dist",
  "framework": "vite",
  "build": {
    "env": {
      "VITE_ENUBOT_DRIVER": "cached",
      "VITE_ENUBOT_VISION": "mediapipe",
      "VITE_ENUBOT_PROXY": "/api",
      "VITE_ENUBOT_DEBUG_PAGES": "1"
    }
  },
  "headers": [
    {
      "source": "/fallback/manifest.json",
      "headers": [{ "key": "Cache-Control", "value": "public, no-cache" }]
    },
    {
      "source": "/fallback/((?!manifest\\.json).*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/models/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/mediapipe/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    }
  ]
}
