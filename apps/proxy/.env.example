# Copy to .env and fill in. NEVER commit .env, and never move any of these into
# the browser bundle — a public kiosk means a visitor with a keyboard.

# --- LLM ---------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Model for the voice path. Defaults to claude-opus-5.
#
# Week 3 latency work should A/B this against claude-haiku-4-5: the budget is
# ~600ms to first token, and the task (ten scripted answers, 2-3 sentences, in
# character) is well inside a small model's range. Measure with the debug HUD's
# p95 before deciding — do not switch on assumption.
ENUBOT_LLM_MODEL=claude-opus-5

# --- Voice route -------------------------------------------------------------
# Which shape of gesture instruction the system prompt carries. This is not
# cosmetic: Route B strips inline [wave] tags before anything is synthesised,
# while Route A hands the model's text straight to ElevenLabs' TTS, so a stray
# tag is read aloud to a visitor as the word "wave".
#
# Leave this on `assembled` until the ElevenLabs adapter actually exists — the
# mock driver and POST /chat both parse inline tags. Flip it in the same change
# that starts pushing the prompt to the agent.
#
#   assembled         inline [wave] [point] [shrug] [nod] [think]
#   elevenlabs-agents play_gesture client tool, tags forbidden
ENUBOT_VOICE_ROUTE=assembled

# --- Voice (Route A: ElevenLabs Agents) --------------------------------------
# Agent ID is written down once the agent is created — the workspace is empty as
# of the Week-3 spike. See docs/elevenlabs-integration.md §9.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# --- Voice (Route B: assembled) ----------------------------------------------
DEEPGRAM_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Server ------------------------------------------------------------------
# Loopback only in event mode. The proxy runs on the kiosk machine itself, so
# there is no network-exposed surface at the venue, and localhost counts as a
# secure context — getUserMedia works with no TLS certificate.
PROXY_HOST=127.0.0.1
PROXY_PORT=8787
KIOSK_ORIGIN=http://127.0.0.1:5173

# Requests per minute. A tampered kiosk should be able to annoy, not bankrupt.
# Set spend caps on every provider dashboard as well — this is only one layer.
RATE_LIMIT_PER_MINUTE=60

# Set to 1 on event day: disables transcript logging. Visitor speech is personal
# data and we have no reason to keep it.
EVENT_MODE=0
