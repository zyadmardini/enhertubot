{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run vision:assets && npm run build",
  "outputDirectory": "apps/kiosk/dist",
  "framework": "vite",
  "build": {
    "env": {
      "VITE_ENUBOT_DRIVER": "cached",
      "VITE_ENUBOT_VISION": "mediapipe",
      "VITE_ENUBOT_PROXY": "/api"
    }
  }
}
